# ==============================================================================
# Student Management System - Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE and Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Python & FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
env.bak/
venv.bak/

# SQLite Databases & Storage
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/student.db

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Node.js & Frontend (Vite / React)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local

# Vite / Build tool artifacts
.vite/
project/dist/
.bolt/
