# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to '.env' and adjust values as needed.
# Do NOT commit sensitive credentials or production database URLs to Git.
# ==============================================================================

# Database Connection URL (Defaults to SQLite backend/student.db if left unset)
STUDENT_DB=sqlite:///student.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000
